# Environment variables schema for the application

# Allowed NODE_ENV values: 'development' | 'production' | 'test'
NODE_ENV='development'

# Allowed LOG_LEVEL values: 'verbose' | 'debug' | 'log' | 'warn' | 'error' | 'fatal'
LOG_LEVEL='log'

APP_NAME='App'
APP_HOST='0.0.0.0'
APP_PORT='9898'
APP_URL='http://0.0.0.0:9898'

# Comma-separated list of allowed CORS origins
CORS_ORIGINS='http://localhost:5173'

JWT_SECRET=''
JWT_EXPIRES_IN='3600'
JWT_REFRESH_SECRET=''
JWT_REFRESH_EXPIRES_IN='604800'

HASH_SALT='5'

DB_HOST='db'
DB_PORT='5432'
DB_USER='user'
DB_PASSWORD='password'
DB_NAME='db_name'
DB_SYNCHRONIZE='false'
DB_DROP_SCHEMA='false'

ADMIN_EMAIL='admin@admin.com'
ADMIN_PASSWORD='admin_password'
