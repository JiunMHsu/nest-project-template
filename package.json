{
    "name": "nest-project-template",
    "version": "0.1.0",
    "description": "",
    "author": "Jiun Ming Hsu",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "test:unit": "vitest run --config ./vitest.config.unit.ts",
        "test:integration": "vitest run --config ./vitest.config.integration.ts",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
        "seed": "pnpm run build && node dist/infrastructure/database/seeder/command.js",
        "seed:clear": "pnpm run build && node dist/infrastructure/database/seeder/command.js --clear",
        "seed:dev": "pnpm run seed:clear",
        "seed:prod": "pnpm run seed",
        "migration:gen": "pnpm run build && sh -c 'pnpm exec typeorm migration:generate src/infrastructure/database/migrations/$1 -d dist/infrastructure/database/postgres/postgres.datasource.js' --",
        "migration:run": "pnpm run build && pnpm exec typeorm migration:run -d dist/infrastructure/database/postgres/postgres.datasource.js",
        "migration:revert": "pnpm run build && pnpm exec typeorm migration:revert -d dist/infrastructure/database/postgres/postgres.datasource.js",
        "migration:show": "pnpm run build && pnpm exec typeorm migration:show -d dist/infrastructure/database/postgres/postgres.datasource.js",
        "migration:create": "sh -c 'pnpm exec typeorm migration:create src/infrastructure/database/migrations/$1' --",
        "migration:drop": "pnpm run build && pnpm exec typeorm schema:drop -d dist/infrastructure/database/postgres/postgres.datasource.js"
    },
    "dependencies": {
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.2.3",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^11.2.0",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/typeorm": "^11.0.3",
        "axios": "^1.20.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "express-session": "^1.19.0",
        "luxon": "^3.7.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.23.0",
        "qs": "^6.16.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^1.1.0",
        "typeorm-naming-strategies": "^4.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.2.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/luxon": "^3.7.4",
        "@types/node": "^24.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/qs": "^6.15.1",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.11.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.69.0",
        "unplugin-swc": "^1.5.11",
        "vite": "^8.2.2",
        "vitest": "^4.1.10",
        "vitest-mock-extended": "^5.1.1"
    }
}
